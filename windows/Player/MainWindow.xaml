<Window x:Class="Spiewak.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:native="using:Spiewak.Native">
<Grid x:Name="Shell" RequestedTheme="Dark" Background="{ThemeResource AppCanvas}" Loaded="OnLoaded">
 <Grid.KeyboardAccelerators>
  <KeyboardAccelerator Key="Space" Invoked="ToggleShortcut" /><KeyboardAccelerator Key="D" Modifiers="Control" Invoked="FavoriteShortcut"/>
  <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackShortcut"/><KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardShortcut"/><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut"/>
 </Grid.KeyboardAccelerators>
 <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
 <Border Grid.Row="0" BorderBrush="{ThemeResource AppLine}" BorderThickness="0,0,0,1" Padding="20,0">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10"><FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="{ThemeResource AppAccent}"/><TextBlock Text="Śpiewak" FontSize="19" FontWeight="SemiBold"/></StackPanel>
   <TextBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="Search your music…  Ctrl+F" TextChanged="SearchChanged" KeyDown="SearchKeyDown" MaxLength="256" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,0,24,0" AutomationProperties.Name="Search library"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <ToggleButton x:Name="CompactToggle" Content="Compact" Click="DensityChanged" AutomationProperties.Name="Compact track rows"/>
    <ToggleButton x:Name="QueueToggle" IsChecked="True" Content="Queue" Click="QueueVisibilityChanged" AutomationProperties.Name="Show queue"/>
   </StackPanel>
  </Grid>
 </Border>
 <Grid Grid.Row="1">
  <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="QueueColumn" Width="272"/></Grid.ColumnDefinitions>
  <Border BorderBrush="{ThemeResource AppLine}" BorderThickness="0,0,1,0" Background="{ThemeResource AppPanel}">
   <Grid Padding="12,20,12,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="12" Margin="8,0,8,18"><TextBlock Text="LIBRARY" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{ThemeResource AppMuted}"/><TextBlock Text="Folders" FontSize="18" FontWeight="SemiBold"/></StackPanel>
    <Button Grid.Row="1" x:Name="AddButton" Content="＋ Add music folder" HorizontalAlignment="Stretch" Click="AddFolder" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="2" Spacing="2" Margin="0,0,0,12"><Button Content="♥ Favorites" Tag="0" Click="ListeningClicked" HorizontalAlignment="Stretch"/><Button Content="Recently added" Tag="1" Click="ListeningClicked" HorizontalAlignment="Stretch"/><Button Content="Listening history" Tag="2" Click="ListeningClicked" HorizontalAlignment="Stretch"/></StackPanel>
    <TreeView Grid.Row="3" x:Name="FolderTree" SelectionMode="Single" ItemInvoked="FolderInvoked" Expanding="FolderExpanding" AutomationProperties.Name="Music folders"/>
    <StackPanel Grid.Row="4" Spacing="8" Margin="0,12,0,16"><Grid><TextBlock Text="PLAYLISTS" FontSize="11" Foreground="{ThemeResource AppMuted}"/><Button HorizontalAlignment="Right" Content="＋" Click="CreatePlaylist" AutomationProperties.Name="Create playlist"/></Grid><Button x:Name="RestorePlaylistButton" Content="Restore deleted playlist" Click="RestorePlaylist" Visibility="Collapsed"/><ListView x:Name="PlaylistList" MaxHeight="150" IsItemClickEnabled="True" ItemClick="PlaylistClicked" AutomationProperties.Name="Playlists"><ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Rename" Click="RenamePlaylist"/><MenuFlyoutItem Text="Delete playlist" Click="DeletePlaylist"/></MenuFlyout></ListView.ContextFlyout></ListView></StackPanel>
    <StackPanel Grid.Row="5" Spacing="8"><ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Visibility="Collapsed"/><Button x:Name="RescanButton" Content="Rescan library" Click="Rescan" HorizontalAlignment="Stretch"/><TextBlock x:Name="LibraryStatus" Text="Ready" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource AppMuted}"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Padding="24,18,24,8" RowSpacing="14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="BackButton" Click="GoBack" IsEnabled="False" ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back"><FontIcon Glyph="&#xE72B;" FontSize="14"/></Button><Button x:Name="ForwardButton" Click="GoForward" IsEnabled="False" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward (Alt+Right)"><FontIcon Glyph="&#xE72A;" FontSize="14"/></Button></StackPanel>
    <TextBlock Grid.Column="1" x:Name="Breadcrumb" Text="Library" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppMuted}"/>
   </Grid>
   <Grid x:Name="FolderHeader" Grid.Row="1" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition x:Name="FolderArtColumn" Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="FolderArtFrame" Width="96" Height="96" CornerRadius="4" Background="{ThemeResource AppRaised}"><Grid><FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource AppMuted}"/><Image x:Name="FolderArt" Stretch="UniformToFill"/></Grid></Border>
    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center"><TextBlock x:Name="FolderHeading" Text="Make yourself at home" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="FolderSummary" Text="Add a music folder to begin. Your files stay exactly where they are." TextWrapping="Wrap" Foreground="{ThemeResource AppMuted}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="FolderViewButton" Content="Folder view" Visibility="Collapsed" AutomationProperties.Name="Folder presentation"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Automatic" Tag="0" Click="FolderKindChanged"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Album" Tag="1" Click="FolderKindChanged"/><MenuFlyoutItem Text="Artist folder" Tag="2" Click="FolderKindChanged"/><MenuFlyoutItem Text="Loose tracks" Tag="3" Click="FolderKindChanged"/><MenuFlyoutItem Text="Mixed folder" Tag="4" Click="FolderKindChanged"/><MenuFlyoutItem Text="Compilation" Tag="5" Click="FolderKindChanged"/><MenuFlyoutItem Text="My collection" Tag="6" Click="FolderKindChanged"/></MenuFlyout></Button.Flyout></Button><Button x:Name="PlayFolderButton" Content="▶ Play" Click="PlayFolder" IsEnabled="False"/><StackPanel x:Name="PlaylistTools" Orientation="Horizontal" Visibility="Collapsed" Spacing="4"><Button Content="↑" Click="PlaylistUp" AutomationProperties.Name="Move playlist item up"/><Button Content="↓" Click="PlaylistDown" AutomationProperties.Name="Move playlist item down"/><Button Content="Remove" Click="PlaylistRemove"/></StackPanel><ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="SortChanged" AutomationProperties.Name="Sort tracks"><ComboBoxItem Content="Track number"/><ComboBoxItem Content="Title"/><ComboBoxItem Content="Artist"/><ComboBoxItem Content="Filename"/><ComboBoxItem Content="Shortest first"/><ComboBoxItem Content="Longest first"/></ComboBox></StackPanel></StackPanel>
   </Grid>
   <ListView Grid.Row="2" x:Name="ChildFolders" MaxHeight="170" IsItemClickEnabled="True" ItemClick="ChildFolderClicked" SelectionMode="None" AutomationProperties.Name="Subfolders">
    <ListView.ItemTemplate><DataTemplate x:DataType="native:Folder"><StackPanel Orientation="Horizontal" Spacing="12" Padding="4,4"><FontIcon Glyph="&#xE8B7;" FontSize="16"/><StackPanel Spacing="2"><TextBlock Text="{x:Bind Name}"/><TextBlock Text="{x:Bind Summary}" FontSize="11" Foreground="{ThemeResource AppMuted}"/></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <Grid Grid.Row="3" Padding="12,0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="54"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
    <TextBlock Text="#" FontSize="11" Foreground="{ThemeResource AppMuted}"/><TextBlock Grid.Column="1" Text="TITLE / FILE" FontSize="11" Foreground="{ThemeResource AppMuted}"/><TextBlock Grid.Column="2" Text="ARTIST" FontSize="11" Foreground="{ThemeResource AppMuted}"/><TextBlock Grid.Column="3" Text="CODEC" FontSize="11" Foreground="{ThemeResource AppMuted}"/><TextBlock Grid.Column="4" Text="TIME" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource AppMuted}"/>
   </Grid>
   <Grid Grid.Row="4">
    <ListView x:Name="TrackList" SelectionMode="Extended" DoubleTapped="TrackDoubleTapped" KeyDown="TrackKeyDown" SelectionChanged="TrackSelectionChanged" AutomationProperties.Name="Tracks">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="44"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate x:DataType="native:Track">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="54"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
       <TextBlock Text="{x:Bind TrackNumber}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource AppMuted}"/>
       <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{x:Bind DisplayTitle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind FileName}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppMuted}"/></StackPanel>
       <TextBlock Grid.Column="2" Text="{x:Bind ArtistLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource AppMuted}"/><TextBlock Grid.Column="3" Text="{x:Bind Codec}" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource AppMuted}"/><TextBlock Grid.Column="4" Text="{x:Bind Time}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
     <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Play selection" Click="PlaySelected"/><MenuFlyoutItem Text="Play next" Click="AddNext"/><MenuFlyoutItem Text="Add to queue" Click="AddToQueue"/><MenuFlyoutSubItem x:Name="AddToPlaylistMenu" Text="Add to playlist"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Toggle favorite (Ctrl+D)" Click="ToggleSelectedFavorite"/><MenuFlyoutItem Text="Show in Explorer" Click="ShowSelected"/></MenuFlyout></ListView.ContextFlyout>
    </ListView>
    <TextBlock x:Name="EmptyState" Text="Your collection starts with a folder." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AppMuted}" TextWrapping="Wrap"/>
   </Grid>
   <StackPanel Grid.Row="5" Spacing="8"><Button x:Name="MoreButton" Content="Load more tracks" Click="LoadMore" Visibility="Collapsed"/><InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True"/></StackPanel>
  </Grid>
  <Border Grid.Column="2" x:Name="QueuePanel" BorderBrush="{ThemeResource AppLine}" BorderThickness="1,0,0,0" Background="{ThemeResource AppPanel}">
   <Grid Padding="18,20" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="8"><TextBlock Text="UP NEXT" FontWeight="SemiBold" FontSize="11" CharacterSpacing="120"/><TextBlock x:Name="QueueSummary" Text="Play a track to build your queue." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AppMuted}"/></StackPanel>
    <ListView Grid.Row="1" x:Name="QueueList" SelectionMode="Single" DoubleTapped="QueueDoubleTapped" KeyDown="QueueKeyDown" AutomationProperties.Name="Playback queue">
     <ListView.ItemTemplate><DataTemplate x:DataType="native:Track"><StackPanel Padding="0,6" Spacing="3"><TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind ArtistLabel}" FontSize="11" Foreground="{ThemeResource AppMuted}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel Grid.Row="2" Spacing="8">
     <StackPanel Orientation="Horizontal" Spacing="4"><Button Content="↑" Click="MoveQueueUp" AutomationProperties.Name="Move queue item up"/><Button Content="↓" Click="MoveQueueDown" AutomationProperties.Name="Move queue item down"/><Button Content="−" Click="RemoveQueue" AutomationProperties.Name="Remove from queue"/><Button Content="Clear" Click="ClearQueue" ToolTipService.ToolTip="Clear upcoming tracks"/></StackPanel>
     <Button x:Name="SelectedFavoriteButton" Content="♥ Add to favorites" Click="ToggleSelectedFavorite" IsEnabled="False" AutomationProperties.Name="Toggle selected tracks as favorites" ToolTipService.ToolTip="Selected tracks · Ctrl+D"/><Button Content="Save queue as playlist" Click="SaveQueue" HorizontalAlignment="Stretch"/><TextBlock Text="FILE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppMuted}"/><TextBlock x:Name="InspectorPath" Text="Select a track to inspect its location." FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource AppMuted}"/><TextBlock x:Name="InspectorAlbum" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource AppMuted}"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
 <Border Grid.Row="2" BorderBrush="{ThemeResource AppLine}" BorderThickness="0,1,0,0" Background="{ThemeResource AppPanel}" Padding="20,12">
  <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="56" Height="56" CornerRadius="3" Background="{ThemeResource AppRaised}"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="24"/><Image x:Name="PlayingArt" Stretch="UniformToFill"/></Grid></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="PlayingTitle" Text="Nothing playing" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlayingArtist" Text="Choose something from your folders" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppMuted}"/></StackPanel>
   </Grid>
   <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
     <Button x:Name="PlayingFavoriteButton" Content="♡" Click="TogglePlayingFavorite" IsEnabled="False" Style="{StaticResource TransportButton}" AutomationProperties.Name="Favorite current track" ToolTipService.ToolTip="Favorite current track"/><Button Style="{StaticResource TransportButton}" Click="ShuffleQueue" AutomationProperties.Name="Shuffle upcoming tracks" ToolTipService.ToolTip="Shuffle upcoming"><FontIcon Glyph="&#xE8B1;" FontSize="16"/></Button>
     <Button Style="{StaticResource TransportButton}" Click="Previous" AutomationProperties.Name="Previous track" ToolTipService.ToolTip="Previous"><FontIcon Glyph="&#xE892;" FontSize="16"/></Button>
     <Button Background="{ThemeResource AppAccent}" Foreground="#191C24" Width="44" Height="40" CornerRadius="20" Click="TogglePlayback" AutomationProperties.Name="Play or pause" ToolTipService.ToolTip="Play / pause (Space)"><FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="18"/></Button>
     <Button Style="{StaticResource TransportButton}" Click="Next" AutomationProperties.Name="Next track" ToolTipService.ToolTip="Next"><FontIcon Glyph="&#xE893;" FontSize="16"/></Button>
     <Button Style="{StaticResource TransportButton}" Click="Stop" AutomationProperties.Name="Stop playback" ToolTipService.ToolTip="Stop"><FontIcon Glyph="&#xE71A;" FontSize="13"/></Button>
     <Button Style="{StaticResource TransportButton}" Click="CycleRepeat" AutomationProperties.Name="Repeat mode" ToolTipService.ToolTip="Cycle repeat: off, queue, track"><TextBlock x:Name="RepeatLabel" Text="↻" FontSize="18"/></Button>
    </StackPanel>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PositionText" Text="0:00" VerticalAlignment="Center" FontSize="11"/><Slider x:Name="SeekSlider" Grid.Column="1" IsEnabled="False" Minimum="0" Maximum="1" StepFrequency="0.1" ValueChanged="SeekChanged" AutomationProperties.Name="Playback position"/><TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" FontSize="11" HorizontalAlignment="Right"/>
    </Grid>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10"><Button Style="{StaticResource TransportButton}" Click="Mute" AutomationProperties.Name="Mute" ToolTipService.ToolTip="Mute"><FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="17"/></Button><Slider x:Name="VolumeSlider" Width="115" Minimum="0" Maximum="100" Value="75" ValueChanged="VolumeChanged" AutomationProperties.Name="Volume"/></StackPanel>
  </Grid>
 </Border>
</Grid>
</Window>
