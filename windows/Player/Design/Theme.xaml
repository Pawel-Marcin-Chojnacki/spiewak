<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Dark">
   <SolidColorBrush x:Key="AppCanvas" Color="#13151B"/><SolidColorBrush x:Key="AppPanel" Color="#191C24"/><SolidColorBrush x:Key="AppRaised" Color="#242834"/>
   <SolidColorBrush x:Key="AppText" Color="#F3F1ED"/><SolidColorBrush x:Key="AppMuted" Color="#A5A8B7"/><SolidColorBrush x:Key="AppLine" Color="#2C303C"/><SolidColorBrush x:Key="AppAccent" Color="#C5B5F5"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="AppCanvas" Color="#F7F6F3"/><SolidColorBrush x:Key="AppPanel" Color="#EFEEEB"/><SolidColorBrush x:Key="AppRaised" Color="#E2E0DC"/>
   <SolidColorBrush x:Key="AppText" Color="#24232B"/><SolidColorBrush x:Key="AppMuted" Color="#646371"/><SolidColorBrush x:Key="AppLine" Color="#DAD8D4"/><SolidColorBrush x:Key="AppAccent" Color="#62508E"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="AppCanvas" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="AppPanel" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="AppRaised" Color="{ThemeResource SystemColorButtonFaceColor}"/>
   <SolidColorBrush x:Key="AppText" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="AppMuted" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="AppLine" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="AppAccent" Color="{ThemeResource SystemColorHighlightColor}"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style TargetType="Button"><Setter Property="Background" Value="{ThemeResource AppRaised}"/><Setter Property="Foreground" Value="{ThemeResource AppText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="12,8"/></Style>
 <Style TargetType="ToggleButton"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource AppMuted}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="4"/></Style>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource AppText}"/></Style>
 <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="6"/></Style>
</ResourceDictionary>